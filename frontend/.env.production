# Production frontend build (Vite mode=production).
# Leave VITE_API_URL empty so the app uses same-origin relative "/api"
# and "/uploads" — Nginx must proxy those to the Node backend.
# Do NOT set VITE_API_URL to localhost or the site will break for visitors.

# Public site URL — required for canonical / Open Graph / sitemap.
VITE_SITE_URL=https://raguwinswereldwinkel.nl

VITE_SITE_OG_NAME=Wins Wereld Winkel
