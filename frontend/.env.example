# =============================================================================
# Frontend environment variables (Vite)
# Copy to `.env` for LOCAL dev. For production use `.env.production`.
# =============================================================================

# --- API base origin ---
# LOCAL DEV: leave it pointing at the local backend OR leave it EMPTY to use the
# Vite dev proxy (vite.config.js proxies /api -> VITE_PROXY_TARGET).
#
# PRODUCTION: leave this EMPTY so the app calls a SAME-ORIGIN relative "/api".
# That requires Nginx to proxy /api and /uploads to the backend (see
# nginx.conf.example). Setting an absolute localhost URL here will break the
# deployed site because the browser would try to reach the visitor's own machine.
VITE_API_URL=http://localhost:5000

# Public site URL (used for SEO canonical tags / sitemap / social share links)
VITE_SITE_URL=http://localhost:5173

# Open Graph site name shown in Facebook / social previews
VITE_SITE_OG_NAME=Wins Wereld Winkel Supermarket

# Optional: backend target for the local Vite dev proxy (defaults to http://localhost:5000)
# VITE_PROXY_TARGET=http://localhost:5000
