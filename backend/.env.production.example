# Server-side production environment template for the Node backend.
# Copy values into the droplet's backend/.env (do not commit secrets).

PORT=5000
NODE_ENV=production

# MongoDB Atlas (required)
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — production site origins (comma-separated)
CORS_ORIGINS=https://raguwinswereldwinkel.nl,https://www.raguwinswereldwinkel.nl

# Public URLs
FRONTEND_URL=https://raguwinswereldwinkel.nl
SITE_URL=https://raguwinswereldwinkel.nl
SITE_OG_NAME=Wins Wereld Winkel

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=
STORE_NAME=Wins Wereld Winkel
